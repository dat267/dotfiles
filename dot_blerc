# ~/.blerc
# Configuration to make ble.sh behave as close to original Bash as possible,
# keeping only syntax highlighting and history autocompletion preview (like PowerShell/Zsh).

# -----------------------------------------------------------------------------
# 1. Readline Compatibility
# -----------------------------------------------------------------------------
# Load Readline compatibility module to restore standard Bash keybindings and TAB completion
ble-import config/readline

# -----------------------------------------------------------------------------
# 2. Re-enable Syntax Highlighting & History Suggestions
# -----------------------------------------------------------------------------
# Re-enable syntax highlighting (which config/readline disabled)
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1

# Enable automatic suggestions engine (needed for history suggestions)
bleopt complete_auto_complete=1

# Enable history-based suggestions (like zsh-autosuggestions)
bleopt complete_auto_history=1

# Disable syntax-based auto-completion popup menu while typing (keeps history only)
bleopt complete_auto_complete_opts=syntax-disabled

# Disable ambiguous completion / menus on TAB
bleopt complete_menu_complete=

# -----------------------------------------------------------------------------
# 3. Generic GNU/Linux ANSI-compliant Color Palette
# -----------------------------------------------------------------------------

# History Autocomplete / Suggestion Preview (Standard Terminal Gray)
ble-face auto_complete='fg=gray,italic'

# Selection / Highlight
ble-face region='bg=gray,fg=black'

# General Syntax Highlighting
ble-face syntax_default='none'
ble-face syntax_command='fg=brown'
ble-face syntax_quoted='fg=green'          # Strings
ble-face syntax_quotation='fg=green,bold'
ble-face syntax_escape='fg=magenta'
ble-face syntax_expr='fg=cyan'
ble-face syntax_error='bg=red,fg=white'
ble-face syntax_varname='fg=red'           # Variables
ble-face syntax_delimiter='bold'
ble-face syntax_param_expansion='fg=magenta'
ble-face syntax_history_expansion='bg=brown,fg=white'
ble-face syntax_function_name='fg=magenta,bold'
ble-face syntax_comment='fg=gray,italic'
ble-face syntax_glob='fg=magenta,bold'
ble-face syntax_brace='fg=cyan,bold'
ble-face syntax_tilde='fg=blue,bold'

# Command Type Specifics
ble-face command_builtin_dot='fg=red,bold'
ble-face command_builtin='fg=red'
ble-face command_alias='fg=cyan'
ble-face command_function='fg=cyan'
ble-face command_file='fg=green'
ble-face command_keyword='fg=blue,bold'    # Keywords (if, case, etc.)
ble-face command_jobs='fg=red,bold'
ble-face command_directory='fg=blue,underline'
