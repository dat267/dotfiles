#!/usr/bin/env bash
# Cloud Shell runs ~/.customize_environment at container startup (Cloud Shell
# Settings → Dotfiles must be set to clone this repo). Installs chezmoi and
# initializes the dotfiles source — deliberately WITHOUT `apply`: the managed
# set targets the Termux/Linux desktops, and applying it blind on Cloud Shell
# would replace .profile/.bashrc and drop desktop-only config. `cm` gives
# manual control from there (cm diff / cm cd / cm apply).
set -u

if ! command -v chezmoi >/dev/null 2>&1; then
	curl -fsLS https://get.chezmoi.io | sh -s -- -b "$HOME/.local/bin" >/dev/null 2>&1 || true
fi
export PATH="$HOME/.local/bin:$PATH"

if command -v chezmoi >/dev/null 2>&1 && [ ! -d "$HOME/.local/share/chezmoi" ]; then
	chezmoi init dat267/dotfiles >/dev/null 2>&1 || true
fi

# Same cm() as dot_profile — duplicated because Cloud Shell sessions are
# stock bash and never source the managed dot_profile.
if [ -f "$HOME/.bashrc" ] && ! grep -q '^cm()' "$HOME/.bashrc"; then
	cat >>"$HOME/.bashrc" <<'EOF'
cm() {
	if [ "$1" = "cd" ]; then
		cd "$(chezmoi source-path)"
	else
		chezmoi "$@"
	fi
}
EOF
fi
