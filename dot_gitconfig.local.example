# ~/.gitconfig.local — machine-specific git settings
# Loaded via [include] in ~/.gitconfig. NOT tracked in git.
# Copy from ~/.gitconfig.local.example and fill in values for this machine.

# ---------------------------------------------------------------------------
# Identity override
# Use this to override the default email for all repos on this machine,
# OR use per-directory overrides with ~/.gitconfig-work / ~/.gitconfig-personal
# (those are wired up via [includeIf] in ~/.gitconfig — see below).
# ---------------------------------------------------------------------------
# [user]
# 	email = you@yourcompany.com
# 	name = Your Name

# ---------------------------------------------------------------------------
# Per-directory identity split (already wired in ~/.gitconfig via includeIf)
#
#   ~/repos/work/     → reads ~/.gitconfig-work     (create from dot_gitconfig-work.example)
#   ~/repos/personal/ → reads ~/.gitconfig-personal (create from dot_gitconfig-personal.example)
#
# This means git automatically uses the right email per project folder
# without any extra thought — safe for both work and personal machines.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Credential helpers
# ---------------------------------------------------------------------------
# [credential]
# 	helper = manager              # Windows Credential Manager
# 	# helper = osxkeychain       # macOS
# 	# helper = /usr/share/doc/git/contrib/credential/gnome-keyring/git-credential-gnome-keyring  # Linux
