#!/usr/bin/env python3
"""Tiny HTTPS CONNECT proxy for vix on Termux.
Bypasses Go's broken DNS resolver (can't read /etc/resolv.conf on Android).
Run: vix-proxy [port]  (default 8888)
"""
import socket, select, sys, threading

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8888

def handle(conn, addr):
    try:
        req = conn.recv(4096)
        if not req: return
        line = req.split(b'\r\n')[0].decode()
        parts = line.split()
        if len(parts) < 2: return
        host, _, port_s = parts[1].partition(':')
        port = int(port_s) if port_s else 443
        # Python's create_connection resolves DNS via Android's native resolver
        target = socket.create_connection((host, port), timeout=30)
        conn.sendall(b'HTTP/1.1 200 Connection Established\r\n\r\n')
        conn.setblocking(0)
        target.setblocking(0)
        while True:
            r, _, _ = select.select([conn, target], [], [], 60)
            if not r: break
            for s in r:
                data = s.recv(65536)
                if not data: raise ConnectionResetError
                if s is conn: target.sendall(data)
                else: conn.sendall(data)
    except (ConnectionResetError, BrokenPipeError, OSError, EOFError): pass
    except Exception as e:
        print(f"[proxy] {addr}: {e}", file=sys.stderr)
    finally:
        try: conn.close()
        except: pass

srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('127.0.0.1', PORT))
srv.listen(10)

while True:
    conn, addr = srv.accept()
    threading.Thread(target=handle, args=(conn, addr), daemon=True).start()