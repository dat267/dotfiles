keyboard "Windows-compatible"

# Windows Terminal parity:
# Ctrl+Backspace deletes the previous word. Konsole's default sends 0x7F
# (same as plain Backspace), which shells cannot distinguish. We send
# 0x17 (Ctrl+W) instead — the native backward-kill-word binding in bash
# and zsh, so no shell-side config is needed.
key Backspace+Ctrl : "\x17"

# Explicit sequences for the rest, matching xterm modifier encoding
# (zshrc already binds these; kept here so the behavior is terminal-guaranteed).
key Left+Ctrl  : "\E[1;5D"
key Right+Ctrl : "\E[1;5C"
key Delete+Ctrl : "\E[3;5~"
