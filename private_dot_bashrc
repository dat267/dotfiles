# shellcheck disable=SC1091
[[ -f ~/.profile ]] && . ~/.profile
[[ $- != *i* ]] && return

HISTTIMEFORMAT="%F %T "
HISTCONTROL=ignoredups
HISTSIZE=10000
HISTFILESIZE=10000
shopt -s histappend
[ -f "/usr/share/doc/pkgfile/command-not-found.bash" ] && source /usr/share/doc/pkgfile/command-not-found.bash
if [ -n "$NVM_DIR" ] && [ -s "$NVM_DIR/bash_completion" ]; then
	. "$NVM_DIR/bash_completion"
fi
if [ -f "$HOME/.local/opt/google-cloud-sdk/path.bash.inc" ]; then
	. "$HOME/.local/opt/google-cloud-sdk/path.bash.inc"
fi
if [ -f "$HOME/.local/opt/google-cloud-sdk/completion.bash.inc" ]; then
	. "$HOME/.local/opt/google-cloud-sdk/completion.bash.inc"
fi
if [ -f "/google/devshell/bashrc.google" ]; then
	source "/google/devshell/bashrc.google"
fi
if [ -f "$HOME/lib/azure-cli/az.completion" ]; then
	source "$HOME/lib/azure-cli/az.completion"
fi
export PS1='\[$(if [[ $? -eq 0 ]]; then printf "\e[0;32m"; else printf "\e[0;31m"; fi)\]\w\[\e[0m\] \$ '
# Auto-detect and activate Python virtual environment in current or parent directories
_auto_run_venv() {
	[[ -t 1 ]] || return
	local dir="$PWD"
	local venv_path=""
	while [[ "$dir" != "/" ]]; do
		if [[ -f "$dir/.venv/bin/activate" && -O "$dir/.venv/bin/activate" ]]; then
			venv_path="$dir/.venv"
			break
		elif [[ -f "$dir/venv/bin/activate" && -O "$dir/venv/bin/activate" ]]; then
			venv_path="$dir/venv"
			break
		fi
		dir="$(dirname "$dir")"
	done

	if [[ -n "$venv_path" ]]; then
		if [[ "$VIRTUAL_ENV" != "$venv_path" ]]; then
			if declare -f deactivate >/dev/null; then
				deactivate
			fi
			source "$venv_path/bin/activate"
		fi
	else
		if [[ -n "$VIRTUAL_ENV" ]] && declare -f deactivate >/dev/null; then
			deactivate
		fi
	fi
}

if [[ ";$PROMPT_COMMAND;" != *";_auto_run_venv;"* ]]; then
	PROMPT_COMMAND="_auto_run_venv${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
