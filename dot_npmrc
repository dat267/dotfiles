# User-level global install location: `npm i -g` installs into ~/.local
# (binaries in ~/.local/bin, already on PATH via dot_profile) instead of
# /usr/lib/node_modules, which needs root (EACCES on system npm).
# npm expands ${HOME} in config values.
prefix=${HOME}/.local

# Retained from the pre-existing ~/.npmrc: allow installing deps from any git host.
allow-git=all