[core]
autocrlf = input
[init]
defaultBranch = "main"
[pull]
rebase = false
[color]
ui = "auto"
[rebase]
autosquash = true
[merge]
allowUnrelatedHistories = true
[push]
autoSetupRemote = true
[user]
email = "dat267@outlook.com"
name = "Dat Do"

# Proxy host/port come from the PowerShell profile's HTTP(S)_PROXY env vars
# (system proxy + Credential Manager), so nothing is embedded here.
# `proxyAuthMethod = negotiate` makes git authenticate to the proxy with the
# current Windows user's integrated credentials (SSPI) — the same
# `currentuser@default` scoop uses. This avoids GCM being invoked for the
# proxy, which would otherwise persist `provider = generic` into this file.
[http]
	proxyAuthMethod = negotiate

# Machine-local overrides (tokens, identity, etc.) — not tracked in git
[include]
	path = ~/.gitconfig.local
