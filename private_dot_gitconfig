[core]
autocrlf = input
[init]
defaultBranch = "main"
[pull]
rebase = false
[color]
ui = "auto"
[rebase]
autosquash = true
[merge]
allowUnrelatedHistories = true
[push]
autoSetupRemote = true
[user]
email = "dat267@outlook.com"
name = "Dat Do"

# Proxy host/port come from the PowerShell profile's HTTP(S)_PROXY env vars
# (system proxy + Credential Manager), so nothing is embedded here.
# `proxyAuthMethod = anyauth` auto-negotiates the auth method with the proxy
# (libcurl picks NTLM when offered, matching scoop's `currentuser@default`).
# This keeps git from invoking the credential helper for the proxy, which
# would otherwise persist `provider = generic` into this file.
[http]
	proxyAuthMethod = anyauth
