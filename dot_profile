prepend_paths() {
	for p in "$@"; do
		if [ -d "$p" ]; then
			case ":$PATH:" in *:"$p":*) ;; *) PATH="$p:$PATH" ;; esac
		fi
	done
}
append_paths() {
	for p in "$@"; do
		if [ -d "$p" ]; then
			case ":$PATH:" in *:"$p":*) ;; *) PATH="$PATH:$p" ;; esac
		fi
	done
}
ensure_directories_exist() {
	for dir in "$@"; do
		if [ ! -L "$dir" ] && [ ! -d "$dir" ]; then
			mkdir -p "$dir"
		fi
	done
}
permit_execution_all() {
	for folder in "$@"; do
		folder="${folder%/}"
		if [ -d "$folder" ]; then
			chmod +x "$folder"/* 2>/dev/null
		fi
	done
	prepend_paths "$@"
}
permit_execution_extension() {
	for folder in "$@"; do
		folder="${folder%/}"
		extension="${folder##*/}"
		if [ -d "$folder" ]; then
			chmod +x "$folder"/*."$extension" 2>/dev/null
		fi
	done
	prepend_paths "$@"
}
