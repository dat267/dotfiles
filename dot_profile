# Smart parent directory jump
up() {
	local limit=$1
	if [ -z "$limit" ]; then
		cd ..
		return
	fi
	if [ "$limit" -eq "$limit" ] 2>/dev/null; then
		local cmd=""
		local i=0
		while [ "$i" -lt "$limit" ]; do
			cmd="../$cmd"
			i=$((i + 1))
		done
		cd "$cmd"
	else
		local target="$PWD"
		while [ "$target" != "/" ] && [ -n "$target" ]; do
			if [ "${target##*/}" = "$limit" ]; then
				cd "$target"
				return
			fi
			local parent="${target%/*}"
			target="${parent:-/}"
		done
		echo "No parent directory matches '$limit'"
	fi
}

