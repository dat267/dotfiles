prepend_paths() {
	for p in "$@"; do
		case ":$PATH:" in *:"$p":*) ;; *) PATH="$p:$PATH" ;; esac
	done
}
append_paths() {
	for p in "$@"; do
		case ":$PATH:" in *:"$p":*) ;; *) PATH="$PATH:$p" ;; esac
	done
}
ensure_directories_exist() {
	for dir in "$@"; do
		if [ ! -L "$dir" ] && [ ! -d "$dir" ]; then
			mkdir -p "$dir"
		fi
	done
}
get_distro_name() {
	if [ -d "$HOME/.termux" ]; then
		echo "android"
	else
		. /etc/os-release
		echo "$ID"
	fi
}
permit_execution_all() {
	for folder in "$@"; do
		folder="${folder%/}"
		chmod +x "$folder"/*
	done
	prepend_paths "$@"
}
permit_execution_extension() {
	for folder in "$@"; do
		folder="${folder%/}"
		extension="${folder##*/}"
		chmod +x "$folder"/*."$extension"
	done
	prepend_paths "$@"
}
