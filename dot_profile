# Download the URL currently in the system clipboard with aria2c.
# Cross-platform: Termux, WSL/git-bash (Windows), and Linux (Wayland/X11).
dlc() {
	local url
	if command -v termux-clipboard-get >/dev/null 2>&1; then
		url=$(termux-clipboard-get)
	elif [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
		url=$(powershell.exe -NoProfile -Command 'Get-Clipboard' 2>/dev/null | tr -d '\r')
	elif [ -e /dev/clipboard ]; then
		url=$(cat /dev/clipboard)
	elif command -v wl-paste >/dev/null 2>&1; then
		url=$(wl-paste --no-newline 2>/dev/null)
	elif command -v xclip >/dev/null 2>&1; then
		url=$(xclip -selection clipboard -o 2>/dev/null)
	elif command -v xsel >/dev/null 2>&1; then
		url=$(xsel -b -o 2>/dev/null)
	else
		echo "dlc: no clipboard provider found" >&2
		return 1
	fi
	url=$(printf '%s' "$url" | tr -d '[:space:]')
	if [ -z "$url" ]; then
		echo "dlc: clipboard is empty" >&2
		return 1
	fi
	case "$url" in
		http://* | https://* | ftp://* | magnet:*) ;;
		*) echo "dlc: clipboard is not a URL: $url" >&2; return 1 ;;
	esac
	aria2c "$url"
}

# SSH tunnel to a remote dsh web GUI (safer than binding dsh to 0.0.0.0):
# forwards the remote :PORT to http://127.0.0.1:PORT on this machine.
# Usage: dsht <user@host> [port]   (Ctrl+C to stop)
dsht() {
	local host="${1:-}"
	if [ -z "$host" ]; then
		echo "Usage: dsht <user@host> [port]" >&2
		return 1
	fi
	local port="${2:-3080}"
	echo "Tunneling http://127.0.0.1:$port -> $host:$port (Ctrl+C to stop)" >&2
	echo "Make sure 'dsh web' is running on the remote." >&2
	ssh -N \
		-o ExitOnForwardFailure=yes \
		-o ServerAliveInterval=30 \
		-o ServerAliveCountMax=3 \
		-L "$port:127.0.0.1:$port" "$host"
}
