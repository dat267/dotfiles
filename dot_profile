mkcd() {
	if [ -z "$1" ]; then
		echo "Usage: mkcd <directory>" >&2
		return 1
	fi
	mkdir -p "$1" && cd "$1"
}
gacp() {
	if [ -z "$1" ]; then
		echo "Error: No commit message provided."
		echo "Usage: gacp <commit message>"
		return 1
	fi
	current_branch=$(git rev-parse --abbrev-ref HEAD)
	git pull origin "$current_branch" &&
		git add -A &&
		git commit -m "$*" &&
		git push
}
