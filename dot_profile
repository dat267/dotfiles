# Resolve sudo once for all package utilities
SUDO=""
command -v sudo >/dev/null 2>&1 && SUDO="sudo"

if command -v pacman >/dev/null 2>&1; then
	ipkgs() { $SUDO pacman -S --noconfirm --needed "$@"; }
	upkgs() { $SUDO pacman -Syu --noconfirm; }
	rpkgs() { $SUDO pacman -Rns --noconfirm "$@"; }
	cpkgs() {
		local orphans
		orphans=$(pacman -Qtdq)
		if [ -z "$orphans" ]; then
			echo "No orphan packages to remove."
		else
			$SUDO pacman -Rns --noconfirm "$orphans"
		fi
	}
elif command -v dnf >/dev/null 2>&1; then
	ipkgs() { $SUDO dnf install -y "$@"; }
	upkgs() { $SUDO dnf upgrade -y; }
	rpkgs() { $SUDO dnf remove -y "$@"; }
	cpkgs() { $SUDO dnf autoremove -y; }
elif command -v apt-get >/dev/null 2>&1; then
	ipkgs() { $SUDO apt-get install -y "$@"; }
	upkgs() { $SUDO apt-get update && $SUDO apt-get upgrade -y; }
	rpkgs() { $SUDO apt-get purge -y "$@"; }
	cpkgs() { $SUDO apt-get autoremove --purge -y; }
elif command -v pkg >/dev/null 2>&1; then
	ipkgs() { pkg install -y "$@"; }
	upkgs() { pkg update && pkg upgrade -y; }
	rpkgs() { pkg uninstall -y "$@"; }
fi
