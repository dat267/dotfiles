# --- SSH agent: use systemd ssh-agent (Linux) or OpenSSH ssh-agent (Termux) ---
# On Linux, systemd socket-activates ssh-agent at /run/user/$UID/ssh-agent.socket.
# On Termux/Android, use a plain OpenSSH ssh-agent on a fixed socket, reused
# across shells. gpg-agent's SSH emulation is NOT used: gpg 2.5 re-protects
# every ssh-added key through pinentry, which needs a TTY the daemon lacks,
# so ssh-add would fail with "agent refused operation" on headless Android.
# OpenSSH's agent keeps keys in memory and needs no pinentry. Keys must be
# added once per agent lifetime with `ssh-add ~/.ssh/id_ed25519` (or let
# AddKeysToAgent yes add them on first successful auth).
if [ -S "/run/user/$(id -u)/ssh-agent.socket" ]; then
	export SSH_AUTH_SOCK="/run/user/$(id -u)/ssh-agent.socket"
elif command -v ssh-agent >/dev/null 2>&1; then
	agent_sock="$HOME/.ssh/ssh-agent.sock"
	if [ -S "$agent_sock" ]; then
		# Socket exists — check if the agent is still alive.
		# ssh-add -l exits 0 (has keys) or 1 (empty, alive);
		# any other exit means the socket is stale (dead agent).
		# Connecting to a dead Unix socket returns ECONNREFUSED
		# instantly, so timeout is only a safety net.
		if command -v timeout >/dev/null 2>&1; then
			SSH_AUTH_SOCK="$agent_sock" timeout 1 ssh-add -l >/dev/null 2>&1
		else
			SSH_AUTH_SOCK="$agent_sock" ssh-add -l >/dev/null 2>&1
		fi
		rc=$?
		if [ $rc -ne 0 ] && [ $rc -ne 1 ]; then
			rm -f "$agent_sock"
		fi
	fi
	if [ ! -S "$agent_sock" ]; then
		mkdir -p "$HOME/.ssh"
		eval "$(ssh-agent -a "$agent_sock" 2>/dev/null)"
	fi
	export SSH_AUTH_SOCK="$agent_sock"
fi
