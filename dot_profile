lfcd() {
	if ! command -v lf >/dev/null 2>&1; then
		echo "lf: command not found" >&2
		return 127
	fi
	local tmp
	tmp="$(mktemp -t "lfcd-cwd.XXXXXX")"
	command lf -last-dir-path="$tmp" "$@"
	if [ -s "$tmp" ]; then
		local last_dir
		read -r last_dir < "$tmp"
		if [ -d "$last_dir" ] && [ "$last_dir" != "$PWD" ]; then
			cd "$last_dir"
		fi
	fi
	rm -f -- "$tmp"
}
y() {
	if ! command -v yazi >/dev/null 2>&1; then
		echo "yazi: command not found" >&2
		return 127
	fi
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp" 2>/dev/null
	if [ -s "$tmp" ]; then
		local cwd
		read -r cwd < "$tmp"
		if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
			builtin cd -- "$cwd"
		fi
	fi
	rm -f -- "$tmp"
}
