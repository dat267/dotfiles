if command -v pacman >/dev/null 2>&1; then
	ipkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s pacman -S --noconfirm --needed "$@"
	}
	upkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s pacman -Syu --noconfirm
	}
	rpkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s pacman -Rns --noconfirm "$@"
	}
	cpkgs() {
		orphans=$(pacman -Qtdq)
		if [ -z "$orphans" ]; then
			echo "No orphan packages to remove."
		else
			s=""
			command -v sudo >/dev/null 2>&1 && s="sudo"
			$s pacman -Rns --noconfirm "$orphans"
		fi
	}
elif command -v dnf >/dev/null 2>&1; then
	ipkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s dnf install -y "$@"
	}
	upkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s dnf upgrade -y
	}
	rpkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s dnf remove -y "$@"
	}
	cpkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s dnf autoremove -y
	}
elif command -v apt-get >/dev/null 2>&1; then
	ipkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s apt-get install -y "$@"
	}
	upkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s apt-get update && $s apt-get upgrade -y
	}
	rpkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s apt-get purge -y "$@"
	}
	cpkgs() {
		s=""
		command -v sudo >/dev/null 2>&1 && s="sudo"
		$s apt-get autoremove --purge -y
	}
elif command -v pkg >/dev/null 2>&1; then
	ipkgs() { pkg install -y "$@"; }
	upkgs() { pkg update && pkg upgrade -y; }
	rpkgs() { pkg uninstall -y "$@"; }
fi
