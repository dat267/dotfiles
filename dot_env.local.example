# ~/.env.local — machine-specific environment variables
# Sourced by ~/.profile (bash/zsh) and the PowerShell profile at login.
# NOT tracked in git. Copy from ~/.env.local.example and fill in values.

# ---------------------------------------------------------------------------
# API keys / tokens  (never commit these)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Cloud / infrastructure defaults
# ---------------------------------------------------------------------------
# AWS_PROFILE=default          # or "work-prod", "personal", etc.
# AWS_REGION=us-east-1
# KUBECONFIG=~/.kube/config

# ---------------------------------------------------------------------------
# Tool secrets (Jira, Redash, Slack, etc.)
# Any third-party API integration credentials go here, not in scripts.
# ---------------------------------------------------------------------------
# ATLASSIAN_API_TOKEN=...
# JIRA_EMAIL=you@yourcompany.com
# JIRA_DOMAIN=yourcompany.atlassian.net
# REDASH_URL=https://redash.yourcompany.com
# REDASH_API_KEY=...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...
