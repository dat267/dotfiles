{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/credentials": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod -R 777*": "deny",
      "chown -R *": "ask",
      "eval *": "ask",
      "* | sh": "deny",
      "* | sh -c *": "deny",
      "* | bash": "deny",
      "* | sudo *": "deny",
      "*~/.ssh*": "deny",
      "*/.ssh/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*google_compute_engine*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*~/.aws*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*HTTP_PROXY*": "deny",
      "*HTTPS_PROXY*": "deny",
      "*http_proxy*": "deny",
      "*https_proxy*": "deny",
      "*Http_Proxy*": "deny",
      "*Https_Proxy*": "deny"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
