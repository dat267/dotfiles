{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "external_directory": { "*": "deny" },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/credentials": "deny"
    },
    "task": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git checkout *": "allow",
      "git stash *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm build *": "allow",
      "npm install *": "ask",
      "pnpm *": "ask",
      "yarn *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pkexec *": "deny"
    }
  }
}
