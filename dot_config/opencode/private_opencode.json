  "lsp": true,
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "scout": { "disable": true }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "**/id_rsa*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "edit": {
      "*": "allow",
      "/etc/**": "deny",
      "**/sudoers*": "deny",
      "**/shadow": "deny",
      "**/passwd": "deny",
      "**/gshadow": "deny"
    },
    "task": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny",
      "*~/.ssh*": "deny",
      "*/.ssh/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*~/.aws*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.env*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    }
  }
}
