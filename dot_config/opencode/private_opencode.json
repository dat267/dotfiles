{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "read": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/credentials": "deny"
    },
    "edit": { "*": "ask" },
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod -R 777*": "deny",
      "chown -R *": "deny",
      "eval *": "deny",
      "* | sh": "deny",
      "* | sh -c *": "deny",
      "* | bash": "deny",
      "* | sudo *": "deny",
      "*~/.ssh*": "deny",
      "*/.ssh/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*google_compute_engine*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*~/.aws*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*PROXY_PASSWORD*": "deny",
      "*PROXY_USERNAME*": "deny",
      "*$env:PROXY*": "deny"
    },
    "external_directory": { "*": "ask" }
  }
}
