{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "lsp": true,
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/.pki/**": "deny",
      "~/.docker/**": "deny",
      "~/.kube/**": "deny",
      "~/.config/git/credentials": "deny",
      "~/.local/share/containers/**": "deny",
      "~/.mozilla/**": "deny",
      "~/.config/google-chrome/**": "deny",
      "~/.config/chromium/**": "deny",
      "~/.config/BraveSoftware/**": "deny",
      "~/.config/firefox/**": "deny",
      "~/.config/thunderbird/**": "deny",
      "~/.local/share/thunderbird/**": "deny",
      "~/.config/evolution/**": "deny",
      "~/.local/share/evolution/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/credentials": "deny"
    },
    "edit": {
      "*": "allow",
      "/etc/**": "deny",
      "/usr/**": "deny",
      "/boot/**": "deny",
      "/var/**": "deny",
      "/sbin/**": "deny",
      "/bin/**": "deny",
      "/lib/**": "deny",
      "/lib64/**": "deny",
      "/opt/**": "deny",
      "/root/**": "deny",
      "/dev/**": "deny",
      "/proc/**": "deny",
      "/sys/**": "deny",
      "/run/**": "deny",
      "/snap/**": "deny",
      "/mnt/**": "deny",
      "/media/**": "deny",
      "/lost+found/**": "deny",
      "**/sudoers*": "deny",
      "**/passwd": "deny",
      "**/shadow": "deny",
      "**/gshadow": "deny",
      "**/group": "deny",
      "**/crontab*": "deny",
      "**/*.service": "deny",
      "**/*.timer": "deny"
    },
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod -R 777*": "deny",
      "chown -R *": "ask",
      "eval *": "ask",
      "* | sh": "deny",
      "* | sh -c *": "deny",
      "* | bash": "deny",
      "* | sudo *": "deny",
      "*~/.ssh*": "deny",
      "*/.ssh/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*google_compute_engine*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*~/.aws*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*HTTP_PROXY*": "deny",
      "*HTTPS_PROXY*": "deny",
      "*http_proxy*": "deny",
      "*https_proxy*": "deny",
      "*Http_Proxy*": "deny",
      "*Https_Proxy*": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny",
      "curl * -o *": "deny",
      "wget * -O *": "deny",
      "crontab *": "deny",
      "crontab -e": "deny",
      "useradd *": "deny",
      "userdel *": "deny",
      "groupadd *": "deny",
      "groupdel *": "deny",
      "passwd *": "deny",
      "chpasswd *": "deny",
      "adduser *": "deny",
      "deluser *": "deny",
      "addgroup *": "deny",
      "delgroup *": "deny",
      "visudo*": "deny",
      "ifconfig *": "deny",
      "iwconfig *": "deny",
      "iptables *": "deny",
      "ufw *": "deny",
      "firewall-cmd *": "deny",
      "systemctl *": "deny",
      "systemctl --user *": "ask",
      "journalctl *": "ask",
      "docker *": "ask",
      "podman *": "ask",
      "nmcli *": "deny",
      "nmtui *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "swapon *": "deny",
      "swapoff *": "deny",
      "modprobe *": "deny",
      "insmod *": "deny",
      "rmmod *": "deny",
      "> /dev/*": "deny",
      "> /dev/* 2>&1": "deny",
      ">/dev/*": "deny",
      ">/dev/* 2>&1": "deny",
      "> /etc/*": "deny",
      "> /boot/*": "deny",
      "> /usr/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    }
  }
}
