{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "external_directory": { "*": "deny" },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/credentials": "deny"
    },
    "task": "ask",
    "bash": {
      "*": "deny",
      "ls *": "allow",
      "pwd": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git checkout *": "allow",
      "git stash *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm build *": "allow",
      "chezmoi apply*": "allow",
      "chezmoi status*": "allow",
      "chezmoi diff*": "allow",
      "chezmoi verify*": "allow",
      "chezmoi managed*": "allow",
      "chezmoi unmanaged*": "allow",
      "chezmoi doctor*": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "uname *": "allow",
      "date": "allow",
      "df -h*": "allow",
      "du -sh *": "allow",
      "file *": "allow",
      "rg -l*": "allow",
      "rg --files*": "allow",
      "git fetch *": "allow",
      "git remote *": "allow",
      "git tag *": "allow",
      "git reflog *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git blame *": "allow",
      "git describe *": "allow",
      "git merge-base *": "allow",
      "go version": "allow",
      "go env *": "allow",
      "go list *": "allow",
      "go vet *": "allow",
      "go doc *": "allow",
      "gofmt -l *": "allow",
      "cargo --version*": "allow",
      "cargo metadata*": "allow",
      "cargo tree*": "allow",
      "cargo search *": "allow",
      "cargo info *": "allow",
      "rustc --version*": "allow",
      "rustup --version*": "allow",
      "rustup toolchain list*": "allow",
      "rustup component list*": "allow",
      "gofmt -w *": "allow",
      "go fmt *": "allow",
      "cargo fmt*": "allow",
      "rustfmt *": "allow",
      "black *": "allow",
      "ruff format *": "allow",
      "isort *": "allow",
      "prettier *": "allow",
      "biome format*": "allow"
    }
  }
}
