{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0a0a0b",
    "bgPanel": "#101012",
    "bgElement": "#161619",
    "border": "#1c1c1f",
    "borderSubtle": "#17171a",
    "borderActive": "#2e2e33",
    "text": "#e4e4e6",
    "textMuted": "#6f6f76",
    "blue": "#7aa2f7",
    "blueDim": "#565f89",
    "green": "#9ece6a",
    "red": "#f7768e",
    "amber": "#e0af68",
    "gray": "#9a9aa2"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "blueDim", "light": "blueDim" },
    "accent": { "dark": "blue", "light": "blue" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "textMuted", "light": "textMuted" },
    "background": { "dark": "bg", "light": "bg" },
