    "markdownEmph": { "dark": "text", "light": "text" },
    "markdownStrong": { "dark": "text", "light": "text" },
    "markdownHorizontalRule": { "dark": "border", "light": "border" },
    "markdownListItem": { "dark": "gray", "light": "gray" },
    "markdownListEnumeration": { "dark": "blue", "light": "blue" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "gray", "light": "gray" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },
    "syntaxComment": { "dark": "textMuted", "light": "textMuted" },
    "syntaxKeyword": { "dark": "blue", "light": "blue" },
    "syntaxFunction": { "dark": "text", "light": "text" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "amber", "light": "amber" },
    "syntaxType": { "dark": "gray", "light": "gray" },
    "syntaxOperator": { "dark": "blueDim", "light": "blueDim" },
