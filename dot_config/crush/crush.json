{
  "$schema": "https://charm.land/crush.json",
  "permissions": {
    "allowed_tools": [
      "view", "ls", "glob", "grep", "edit", "write", "multiedit",
      "fetch", "agentic_fetch", "download",
      "lsp_symbols", "lsp_definition", "lsp_references", "lsp_rename",
      "lsp_replace_symbol", "lsp_diagnostics", "lsp_call_hierarchy"
    ]
  },
  "options": {
    "disabled_tools": [
      "agent", "sourcegraph"
    ],
    "auto_lsp": true,
    "attribution": {
      "trailer_style": "assisted-by",
      "generated_with": true
    },
    "tui": {
      "transparent": true,
      "scrollbar": "never",
      "diff_mode": "unified"
    }
  }
}