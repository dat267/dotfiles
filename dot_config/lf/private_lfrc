# Basic Settings
set nohidden
set preview
set previewer ~/.config/lf/preview.sh
set nodrawbox
set noroundbox
set noicons
set ignorecase
set smartcase
set info
set timefmt "2006-01-02T15:04:05Z"

cmd open-check %{{
    IFS='
'
    [ -n "$fx" ] && files=$fx || files=$f

    for file in $files; do
        mime=$(file -Lb --mime-type "$file")
        case "$mime" in
            text/*|application/json|*javascript|*xml) continue ;;
            *)
                if ! file -Lb "$file" | grep -iq 'text'; then
                    lf -remote "send $id echo 'Opening non-text files is disabled ($mime)'"
                    exit 1
                fi
                ;;
        esac
    done
    lf -remote "send $id open-run"
}}

cmd open-run ${{
    $EDITOR $fx
}}

cmd open :open-check

cmd mkdir %IFS=" "; mkdir -p -- "$*"
cmd touch %touch -- "$1"
cmd follow_link %lf -remote "send ${id} select '$(readlink $f)'"

cmd extract_archive ${{
    case "$f" in
        *.tar.gz|*.tgz) tar -xzf "$f" ;;
        *.tar.xz|*.txz) tar -xJf "$f" ;;
        *.tar) tar -xf "$f" ;;
        *.zip|*.rar|*.7z) 7z x -y "$f" ;;
    esac
    lf -remote "send $id reload"
}}

cmd compress ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    tar -cvzf "archive.tar.gz" -- "$@"
    lf -remote "send $id reload"
}}

# Mappings
map d
map dd cut
map dD delete
map x cut
map p paste
map a push :mkdir<space>
map A push :touch<space>
map gL follow_link
map <enter> :open
map o :open
map <esc> clear

# Extensions Mappings
map E extract_archive
map Z compress
map . set hidden!

# Jump Shortcuts
map gh cd ~
map gc cd ~/.config
map gd cd ~/Downloads
map gD cd ~/Documents
map gt cd /tmp
map g/ cd /
