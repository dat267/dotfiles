set nohidden
set preview
set noicons
set ignorecase
set smartcase
set info
set timefmt "2006-01-02T15:04:05Z"

cmd open ${{
    $EDITOR $fx
}}

cmd mkdir %mkdir -p -- "$*"
cmd touch %touch -- "$1"

cmd extract_archive ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    python3 ~/.local/scripts/py/yazi-extract.py "$@"
    lf -remote "send $id reload"
}}

cmd compress_7z ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    python3 ~/.local/scripts/py/yazi-compress.py 7z "$@"
    lf -remote "send $id reload"
}}

cmd compress_zip ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    python3 ~/.local/scripts/py/yazi-compress.py zip "$@"
    lf -remote "send $id reload"
}}

cmd concat_media ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    python3 ~/.local/scripts/py/yazi-ffmpeg-concat.py "$@"
    lf -remote "send $id reload"
}}

cmd transcode_media ${{
    [ -n "$fx" ] && set -- $fx || set -- "$f"
    python3 ~/.local/scripts/py/yazi-ffmpeg-transcode.py "$@"
    lf -remote "send $id reload"
}}

map <esc> clear
map dd cut
map dD delete
map yy copy
map p paste
map P paste
map <enter> :open
map e :open
map o :open
map a push :mkdir<space>
map A push :touch<space>
map . set hidden!
map r rename

map x extract_archive
map cz compress_zip
map c7 compress_7z
map C concat_media
map T transcode_media
