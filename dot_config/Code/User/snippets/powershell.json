{
	"ms-cli boilerplate": {
		"prefix": "mscli",
		"body": [
			"# ── Your script block ───────────────────────────────────────",
			"$MainPayload = {",
			"  <#",
			"  .SYNOPSIS",
			"  $1",
			"  .PARAMETER ${2:ParamName}",
			"  $3",
			"  #>",
			"  param(",
			"    [Parameter(Mandatory)][${4:string}]$${2:ParamName},",
			"    [switch]$${5:VerboseFlag}",
			"  )",
			"  Write-Host \"  ${2:ParamName}: $${2:ParamName}\" -ForegroundColor Green",
			"  if ($${5:VerboseFlag}) { Write-Host \"  ${5:VerboseFlag} set\" -ForegroundColor Yellow }",
			"  $6",
			"}",
			"",
			"# ── CLI machinery (paste from github.com/dat267/ms at the bottom) ──",
			"# 1. Copy the Invoke-Cli function block from dat267/ms/cli.ps1",
			"# 2. Call it:",
			"Invoke-Cli @args",
			"$0"
		],
		"description": "Scaffold a dat267/ms-style PowerShell CLI (MainPayload + Invoke-Cli call)"
	},
	"try catch finally": {
		"prefix": "try",
		"body": [
			"try {",
			"    $1",
			"} catch {",
			"    Write-Warning \"$($_.Exception.Message)\"",
			"    $2",
			"} finally {",
			"    $3",
			"}",
			"$0"
		],
		"description": "try/catch/finally block"
	},
	"foreach loop": {
		"prefix": "foreach",
		"body": [
			"foreach ($${1:item} in $${2:collection}) {",
			"    $3",
			"}"
		],
		"description": "foreach loop"
	},
	"function with param": {
		"prefix": "func",
		"body": [
			"function ${1:Name} {",
			"    [CmdletBinding()]",
			"    param(",
			"        [Parameter(Mandatory)]${2:[string]}$${3:ParamName}",
			"    )",
			"    $4",
			"}",
			"$0"
		],
		"description": "Function with CmdletBinding and param block"
	}
}
