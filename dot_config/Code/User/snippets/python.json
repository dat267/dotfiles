	"Initial Argparse Boilerplate": {
		"body": [
			"\"\"\"",
			"Module Docstring",
			"\"\"\"",
			"",
			"__author__ = \"Your Name\"",
			"__version__ = \"0.1.0\"",
			"__license__ = \"MIT\"",
			"",
			"import argparse",
			"",
			"",
			"def main():",
			"\t\"\"\"Main entry point of the app\"\"\"",
			"\targs = parse_args()",
			"\t${0:# Code to execute}",
			"",
			"",
			"def parse_args():",
			"\t\"\"\"Parse arguments when running from the command line\"\"\"",
			"\tparser = argparse.ArgumentParser(description='Script description')",
			"\t# Required positional argument",
			"\tparser.add_argument('arg', help='Required positional argument')",
			"\t# Optional argument flag which defaults to False",
			"\tparser.add_argument('-f', '--flag', action='store_true', default=False)",
			"\t# Optional argument which requires a parameter (eg. -d test)",
			"\tparser.add_argument('-n', '--name', action='store', dest='name')",
			"\t# Optional verbosity counter (eg. -v, -vv, -vvv, etc.)",
			"\tparser.add_argument('-v', '--verbose', action='count', default=0, help='Verbosity (-v, -vv, etc)')",
			"\t# Specify output of '--version'",
			"\tparser.add_argument('--version', action='version', version=f'%(prog)s (version {__version__}')",
			"\t# Add more arguments if needed",
			"\treturn parser.parse_args()",
			"",
			"",
			"if __name__ == '__main__':",
			"\tmain()",
			""
		],
		"description": "Initialize Argparse Boilerplate",
		"prefix": "init argparse"
	},
