{
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "chat": {
    "agent.enabled": false,
    "commandCenter.enabled": false,
    "disableAIFeatures": true
  },
  "debug": {
    "showInStatusBar": "always",
    "toolBarLocation": "docked"
  },
  "editor": {
    "minimap.renderCharacters": true,
    "minimap.enabled": true,
    "fontFamily": "'FiraCode Nerd Font', Consolas, 'Courier New', monospace",
    "fontLigatures": false,
    "fontSize": 14,
    "formatOnSave": true,
    "selectionClipboard": false,
    "wordWrap": "off",
    "lightbulb.enabled": "off",
    "hover.delay": 500,
    "guides.bracketPairs": false,
    "semanticHighlighting.enabled": false,
    "stickyScroll.enabled": false,
    "codeLens": false,
    "inlayHints.enabled": "off",
    "bracketPairColorization.enabled": false,
    "occurrencesHighlight": "off",
    "smoothScrolling": false,
    "cursorSmoothCaretAnimation": "off",
    "parameterHints.enabled": false,
    "wordBasedSuggestions": "off",
    "largeFileOptimizations": true,
    "snippetSuggestions": "top"
  },
  "eslint": {
    "format.enable": true
  },
  "explorer": {
    "confirmDelete": false,
    "confirmDragAndDrop": false
  },
  "extensions": {
    "ignoreRecommendations": true,
    "autoUpdate": "off"
  },
  "files": {
    "enableTrash": true,
    "autoSave": "afterDelay",
    "insertFinalNewline": true,
    "trimFinalNewlines": true,
    "trimTrailingWhitespace": true,
    "simpleDialog.enable": true,
    "watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.git/**": true,
      "**/node_modules/*/**": true,
      "**/.hg/store/**": true,
      "**/.hg/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "associations": {
      "*.code-snippets": "jsonc",
      "*.json": "jsonc",
      "*.tmpl": "gotmpl",
      "justfile": "plaintext"
    }
  },
  "git": {
    "autofetch": false,
    "confirmSync": false,
    "enableSmartCommit": true,
    "openRepositoryInParentFolders": "always",
    "allowForcePush": true
  },
  "github": {
    "copilot.nextEditSuggestions.enabled": false,
    "copilot.editor.enableCodeActions": false,
    "copilot.enable": {
      "*": false,
      "plaintext": false,
      "markdown": false,
      "scminput": false
    }
  },
  "go": {
    "toolsManagement.autoUpdate": false
  },
  "gopls": {
    "ui.semanticTokens": false
  },
  "inlineChat": {
    "mode": "live"
  },
  "java": {
    "compile.nullAnalysis.mode": "manual",
    "configuration.updateBuildConfiguration": "disabled",
    "debug.settings.hotCodeReplace": "manual"
  },
  "js/ts": {
    "implicitProjectConfig.target": "ESNext"
  },
  "js/ts.implicitProjectConfig.target": "ESNext",
  "json": {
    "schemaDownload.trustedDomains": {
      "https://schemastore.azurewebsites.net/": true,
      "https://raw.githubusercontent.com/microsoft/vscode/": true,
      "https://raw.githubusercontent.com/devcontainers/spec/": true,
      "https://www.schemastore.org/": true,
      "https://json.schemastore.org/": true,
      "https://json-schema.org/": true,
      "https://developer.microsoft.com/json-schemas/": true,
      "https://opencode.ai/": true
    }
  },
  "material-icon-theme": {
    "hidesExplorerArrows": true
  },
  "notebook": {
    "formatOnSave.enabled": true
  },
  "powershell": {
    "buttons.showRunButtons": false,
    "codeFormatting.autoCorrectAliases": false,
    "codeFormatting.trimWhitespaceAroundPipe": false,
    "codeFormatting.useCorrectCasing": false,
    "codeFormatting.whitespaceBetweenParameters": false,
    "codeFormatting.avoidSemicolonsAsLineTerminators": false,
    "integratedConsole.startInBackground": true,
    "integratedConsole.showOnStartup": false,
    "startAutomatically": true,
    "powerShellAdditionalExePaths": {
      "linux": "${env:HOME}/.local/bin/pwsh"
    }
  },
  "python": {
    "analysis.autoFormatStrings": false,
    "analysis.autoImportCompletions": false,
    "analysis.completeFunctionParens": false,
    "analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "information"
    },
    "analysis.fixAll": [],
    "analysis.inlayHints.functionReturnTypes": false,
    "analysis.inlayHints.variableTypes": false,
    "analysis.typeCheckingMode": "off"
  },
  "redhat": {
    "telemetry.enabled": false
  },
  "remote": {
    "tunnels.alwaysUpdateCLI": false,
    "SSH.remotePlatform": {
      "datbox": "linux",
      "vpx": "linux",
      "nexus": "linux",
      "citadel": "linux"
    }
  },
  "rust-analyzer": {
    "runnables.extraArgs": [
      "--release"
    ]
  },
  "search": {
    "followSymlinks": false,
    "useIgnoreFiles": true,
    "exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true,
      "**/.cache": true,
      "**/.venv": true,
      "**/__pycache__": true
    }
  },
  "security": {
    "workspace.trust.banner": "never",
    "workspace.trust.enabled": false,
    "workspace.trust.startupPrompt": "never",
    "workspace.trust.untrustedFiles": "open",
    "allowedUNCHosts": [
      "wsl.localhost"
    ]
  },
  "svelte": {
    "enable-ts-plugin": false
  },
  "task": {
    "allowAutomaticTasks": "off"
  },
  "telemetry": {
    "telemetryLevel": "off"
  },
  "terminal": {
    "integrated.allowChords": false,
    "integrated.initialHint": false
  },
  "testing": {
    "automaticallyOpenPeekView": "never"
  },
  "window": {
    "commandCenter": false,
    "autoDetectColorScheme": true,
    "dialogStyle": "custom",
    "newWindowDimensions": "maximized",
    "openFoldersInNewWindow": "off",
    "openWithoutArgumentsInNewWindow": "off",
    "restoreWindows": "none",
    "titleBarStyle": "custom"
  },
  "workbench": {
    "settings.showAISearchToggle": false,
    "layoutControl.enabled": false,
    "editor.empty.hint": "hidden",
    "secondarySideBar.defaultVisibility": "hidden",
    "editor.splitInGroupLayout": "vertical",
    "preferredDarkColorTheme": "Dark Modern",
    "preferredLightColorTheme": "Light Modern",
    "startupEditor": "welcomePage",
    "reduceMotion": "on",
    "settings.editor": "json",
    "iconTheme": "material-icon-theme"
  }
}
