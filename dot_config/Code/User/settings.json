{
    "editor.minimap.renderCharacters": false,
    "editor.minimap.enabled": false,
    "files.enableTrash": true,
    "files.autoSave": "afterDelay",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.simpleDialog.enable": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.git/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/.hg/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.cache/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true
    },
    "files.associations": {
        "*.code-snippets": "jsonc",
        "*.json": "jsonc",
        ".lfrc": "properties",
        "*.tmpl": "gotmpl",
        "justfile": "plaintext"
    },
    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.git": true,
        "**/.cache": true,
        "**/.venv": true,
        "**/__pycache__": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "vscode.markdown-language-features"
    },
    "[powershell]": {
        "editor.defaultFormatter": "ms-vscode.powershell"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[svelte]": {
        "editor.defaultFormatter": "svelte.svelte-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "editor.fontFamily": "'FiraCode Nerd Font', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": false,
    "editor.fontSize": 14,
    "editor.formatOnSave": true,
    "editor.selectionClipboard": false,
    "editor.wordWrap": "off",
    "editor.lightbulb.enabled": "off",
    "editor.hover.delay": 500,
    "editor.guides.bracketPairs": false,
    "editor.semanticHighlighting.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.codeLens": false,
    "editor.inlayHints.enabled": "off",
    "editor.bracketPairColorization.enabled": false,
    "editor.occurrencesHighlight": false,
    "editor.smoothScrolling": false,
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.parameterHints.enabled": false,
    "editor.wordBasedSuggestions": "off",
    "editor.largeFileOptimizations": true,
    "chat.agent.enabled": false,
    "chat.commandCenter.enabled": false,
    "chat.disableAIFeatures": true,
    "inlineChat.mode": "live",
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.editor.enableCodeActions": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,
    "workbench.settings.showAISearchToggle": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.splitInGroupLayout": "vertical",
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.preferredLightColorTheme": "Light Modern",
    "workbench.startupEditor": "none",
    "workbench.reduceMotion": "on",
    "workbench.settings.editor": "json",
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.hidesExplorerArrows": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.ignoreRecommendations": true,
    "extensions.autoUpdate": "off",
    "git.autofetch": false,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "git.allowForcePush": true,
    "debug.showInStatusBar": "always",
    "debug.toolBarLocation": "docked",
    "testing.automaticallyOpenPeekView": "never",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.initialHint": false,
    "window.autoDetectColorScheme": true,
    "window.dialogStyle": "custom",
    "window.newWindowDimensions": "maximized",
    "window.openFoldersInNewWindow": "off",
    "window.openWithoutArgumentsInNewWindow": "off",
    "window.restoreWindows": "none",
    "window.titleBarStyle": "custom",
    "remote.tunnels.alwaysUpdateCLI": false,
    "remote.SSH.remotePlatform": {
        "datbox": "linux",
        "vpx": "linux",
        "nexus": "linux",
        "citadel": "linux"
    },
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "eslint.codeActionsOnSave.rules": [],
    "eslint.format.enable": true,
    "go.toolsManagement.autoUpdate": false,
    "gopls": {
        "ui.semanticTokens": false
    },
    "java.compile.nullAnalysis.mode": "manual",
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.debug.settings.hotCodeReplace": "manual",
    "js/ts.implicitProjectConfig.target": "ESNext",
    "notebook.formatOnSave.enabled": true,
    "powershell.buttons.showRunButtons": false,
    "powershell.codeFormatting.autoCorrectAliases": false,
    "powershell.codeFormatting.trimWhitespaceAroundPipe": false,
    "powershell.codeFormatting.useCorrectCasing": false,
    "powershell.codeFormatting.whitespaceBetweenParameters": false,
    "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": false,
    "powershell.integratedConsole.startInBackground": false,
    "powershell.integratedConsole.showOnStartup": false,
    "powershell.startAutomatically": false,
    "powershell.powerShellAdditionalExePaths": {
        "linux": "${env:HOME}/.local/bin/pwsh"
    },
    "python.analysis.autoFormatStrings": false,
    "python.analysis.autoImportCompletions": false,
    "python.analysis.completeFunctionParens": false,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "information"
    },
    "python.analysis.fixAll": [],
    "python.analysis.inlayHints.functionReturnTypes": false,
    "python.analysis.inlayHints.variableTypes": false,
    "python.analysis.typeCheckingMode": "off",
    "rust-analyzer.runnables.extraArgs": [
        "--release"
    ],
    "svelte.enable-ts-plugin": false,
    "task.allowAutomaticTasks": "off",
    "editor.snippetSuggestions": "top"
}
