{{- $_ := setValueAtPath "files" (fromJson `{"enableTrash":true,"autoSave":"afterDelay","insertFinalNewline":true,"trimFinalNewlines":true,"trimTrailingWhitespace":true,"simpleDialog.enable":true,"watcherExclude":{"**/.git/objects/**":true,"**/.git/subtree-cache/**":true,"**/.git/**":true,"**/node_modules/*/**":true,"**/.hg/store/**":true,"**/.hg/**":true,"**/dist/**":true,"**/build/**":true,"**/.cache/**":true,"**/.venv/**":true,"**/__pycache__/**":true},"associations":{"*.code-snippets":"jsonc","*.json":"jsonc","*.tmpl":"gotmpl","justfile":"plaintext"}}`) $config -}}
{{- $_ := setValueAtPath "search" (fromJson `{"followSymlinks":false,"useIgnoreFiles":true,"exclude":{"**/node_modules":true,"**/dist":true,"**/build":true,"**/.git":true,"**/.cache":true,"**/.venv":true,"**/__pycache__":true}}`) $config -}}
