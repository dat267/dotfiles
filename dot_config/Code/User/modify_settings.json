{{- $_ := setValueAtPath "explorer" (fromJson `{"confirmDelete":false,"confirmDragAndDrop":false}`) $config -}}
{{- $_ := setValueAtPath "extensions" (fromJson `{"ignoreRecommendations":true,"autoUpdate":"off"}`) $config -}}
{{- $_ := setValueAtPath "git" (fromJson `{"autofetch":false,"confirmSync":false,"enableSmartCommit":true,"openRepositoryInParentFolders":"always","allowForcePush":true}`) $config -}}
{{- $_ := setValueAtPath "debug" (fromJson `{"showInStatusBar":"always","toolBarLocation":"docked"}`) $config -}}
