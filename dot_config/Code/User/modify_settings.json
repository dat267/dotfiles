{{- $_ := setValueAtPath "telemetry" (fromJson `{"telemetryLevel":"off"}`) $config -}}
{{- $_ := setValueAtPath "redhat" (fromJson `{"telemetry.enabled":false}`) $config -}}
{{- $_ := setValueAtPath "workbench" (fromJson `{"settings.showAISearchToggle":false,"layoutControl.enabled":false,"editor.empty.hint":"hidden","secondarySideBar.defaultVisibility":"hidden","editor.splitInGroupLayout":"vertical","preferredDarkColorTheme":"Dark Modern","preferredLightColorTheme":"Light Modern","startupEditor":"welcomePage","reduceMotion":"on","settings.editor":"json","iconTheme":"material-icon-theme"}`) $config -}}
