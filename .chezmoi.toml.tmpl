
# Reference: https://github.com/twpayne/chezmoi/blob/master/assets/chezmoi.io/docs/reference/configuration-file/variables.md.yaml

[interpreters.sh]
command = "sh"

{{ if lookPath "git" -}}
# Only when a git binary exists — enables deploying from tarballs/zipballs
# on machines without git (no [git] section = no auto-commit attempts).
[git]
autoAdd = true
autoCommit = true
autoPush = false
{{ end -}}
