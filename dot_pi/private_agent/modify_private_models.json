chezmoi:modify-template
{{- /* Cap the context window of every model the enabledModels patterns in
     modify_settings.json resolve to. Their catalogs advertise 1M or more,
     and compaction keys off that number, so an uncapped session grows past
     the point where these models stay coherent and cheap.

     modelOverrides keys are exact provider model IDs, not patterns: when
     enabledModels changes or a catalog renames a model, update this list
     (`pi --list-models` shows the resolved IDs). Unknown IDs are ignored by
     pi, so a stale entry is harmless. Paths are lists because the IDs
     contain dots and slashes. Everything else in models.json, including
     custom providers and other override fields, is preserved. */}}
{{- $current := fromJson (.chezmoi.stdin | default "{}") }}
{{- $cap := 500000 }}
{{- $models := dict
    "commandcode" (list
        "deepseek/deepseek-v4.1-flash"
        "google/gemini-3.8-flash"
        "Qwen/Qwen3.8-Flash"
        "z-ai/glm-5.3-flash")
    "hyper" (list
        "deepseek-v4.1-flash")
    "opencode-go" (list
        "deepseek-v4.1-flash"
        "glm-5.3-flash"
        "gpt-6-luna"
        "mimo-v2.6-flash"
        "mimo-v2.6-pro"
        "qwen3.8-flash") }}
{{- range $provider, $ids := $models }}
{{- range $id := $ids }}
{{- $_ := setValueAtPath (list "providers" $provider "modelOverrides" $id "contextWindow") $cap $current }}
{{- end }}
{{- end }}
{{- toPrettyJson $current -}}
