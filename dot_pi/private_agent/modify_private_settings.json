chezmoi:modify-template
{{- $current := fromJson (.chezmoi.stdin | default "{}") }}
{{- $_ := setValueAtPath "tuiMode" "fullscreen" $current }}
{{- /* "header" keeps the startup header (version and key hints) and hides the model
     scope line and the loaded-resource listing. */}}
{{- $_ := setValueAtPath "quietStartup" "header" $current }}
{{- $_ := setValueAtPath "fullscreenExitOutput" "resume-hint" $current }}
{{- $_ := setValueAtPath "hideThinkingBlock" true $current }}
{{- /* flat: the managed theme, which paints no panel backgrounds. It is written in
     256-color indices and terminal defaults, so it follows the terminal's palette. */}}
{{- $_ := setValueAtPath "theme" "flat" $current }}
{{- $_ := setValueAtPath "steeringMode" "one-at-a-time" $current }}
{{- $_ := setValueAtPath "transport" "auto" $current }}
{{- $_ := setValueAtPath "markdown.mermaid" "streaming" $current }}
{{- $_ := setValueAtPath "defaultProjectTrust" "ask" $current }}
{{- /* The goal extension is gone; drop its retired exclusion entry so an
     already-deployed settings file does not keep a dead reference. Leave the
     key out entirely when it only held that entry. */}}
{{- if hasKey $current "extensions" }}
{{- $extensions := without (index $current "extensions") "-extensions/goal/index.ts" }}
{{- if $extensions }}
{{- $_ := setValueAtPath "extensions" $extensions $current }}
{{- else }}
{{- $_ := unset $current "extensions" }}
{{- end }}
{{- end }}
{{- $_ := setValueAtPath "doubleEscapeAction" "none" $current }}
{{- $_ := setValueAtPath "fullscreenScrollbar" "auto" $current }}
{{- $_ := setValueAtPath "outputPad" 1 $current }}
{{- $_ := setValueAtPath "editorPaddingX" 1 $current }}
{{- /* Scope startup selection and model cycling to the latest selected families.
     Case-insensitive globstars match across providers and nested model IDs.
     A single star cannot cross slashes in Command Code's vendor/model IDs. */}}
{{- $_ := setValueAtPath "enabledModels" (list
    "**/deepseek-v4.1-flash"
    "deepseek/deepseek-flash"
    "**/glm-5.3-flash"
    "**/gpt-6-luna"
    "**/qwen3.8-flash"
    "**/mimo-v2.6*"
) $current }}
{{- /* Use Pi's built-in compaction token defaults. Remove only the previous
     global token settings, preserving enabled and any per-model overrides. */}}
{{- if hasKey $current "compaction" }}
{{- $_ := unset (index $current "compaction") "reserveTokens" }}
{{- $_ := unset (index $current "compaction") "keepRecentTokens" }}
{{- end }}
{{- /* defaultTools is deliberately unmanaged on Linux and macOS: pi's own defaults
     (read, bash, edit, write) are the tool set we want. A modify template only merges,
     so the key is evicted first to drop anything pi or a manual edit persisted into
     the deployed file. Native Windows is different: pi's bash fallback resolves to the
     WSL shim (%SystemRoot%\System32\bash.exe) whenever WSL is installed, so drop the
     bash tool and add the native powershell tool. Only -name/+name entries, so the
     delta mutates pi's inherited selection instead of replacing it. */}}
{{- $_ := unset $current "defaultTools" }}
{{- if eq .chezmoi.os "windows" }}
{{- $_ := setValueAtPath "defaultTools" (list "-bash" "+powershell") $current }}
{{- end }}
{{- trimSuffix "\n" (toPrettyJson $current) -}}
