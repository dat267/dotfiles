chezmoi:modify-template
{{- $current := fromJson (.chezmoi.stdin | default "{}") }}
{{- $_ := setValueAtPath "tuiMode" "fullscreen" $current }}
{{- /* "header" keeps the startup header (version and key hints) and hides the model
     scope line and the loaded-resource listing. */}}
{{- $_ := setValueAtPath "quietStartup" "header" $current }}
{{- $_ := setValueAtPath "fullscreenExitOutput" "resume-hint" $current }}
{{- $_ := setValueAtPath "hideThinkingBlock" true $current }}
{{- /* system: pi derives its colors from the terminal's foreground, background,
     and ANSI palette, and rebuilds them when the terminal switches light/dark. */}}
{{- $_ := setValueAtPath "theme" "system" $current }}
{{- $_ := setValueAtPath "steeringMode" "one-at-a-time" $current }}
{{- $_ := setValueAtPath "transport" "auto" $current }}
{{- $_ := setValueAtPath "markdown.mermaid" "streaming" $current }}
{{- $_ := setValueAtPath "defaultProjectTrust" "ask" $current }}
{{- $_ := setValueAtPath "doubleEscapeAction" "none" $current }}
{{- $_ := setValueAtPath "fullscreenScrollbar" "auto" $current }}
{{- $_ := setValueAtPath "outputPad" 1 $current }}
{{- $_ := setValueAtPath "editorPaddingX" 1 $current }}
{{- /* Pin the thinking default: without it pi falls back to DEFAULT_THINKING_LEVEL
     "medium", which clamps to glm-5.3-flash's supported levels as "high" on a
     clean boot but "low" after modeldefault's setModel re-sync re-derives the level
     from a model-less session's "off" — the thinking level kept flapping. */}}
{{- $_ := setValueAtPath "defaultThinkingLevel" "high" $current }}
{{- /* Compaction: stock caps the summary at 0.8 * reserveTokens (16384 -> ~13k)
     and passes the session thinking level, so a reasoning model spends the cap on
     thinking and the summary aborts with stopReason "length". 40960 gives a
     32768-token summary budget; keepRecentTokens stays at pi's default 20000. */}}
{{- $_ := unset $current "compaction" }}
{{- $_ := setValueAtPath "compaction.reserveTokens" 40960 $current }}
{{- /* defaultTools is deliberately unmanaged: pi's own defaults (read, bash, edit,
     write) are the tool set we want. A modify template only merges, so the key has
     to be evicted to drop anything pi or a manual edit persisted into the deployed
     file (previously the codemode entry). */}}
{{- $_ := unset $current "defaultTools" }}
{{ toPrettyJson $current }}

