chezmoi:modify-template
{{- $current := fromJson (.chezmoi.stdin | default "{}") }}
{{- $_ := setValueAtPath "tuiMode" "fullscreen" $current }}
{{- /* "header" keeps the startup header (version and key hints) and hides the model
     scope line and the loaded-resource listing. */}}
{{- $_ := setValueAtPath "quietStartup" "header" $current }}
{{- $_ := setValueAtPath "fullscreenExitOutput" "resume-hint" $current }}
{{- $_ := setValueAtPath "hideThinkingBlock" true $current }}
{{- /* system: pi derives its colors from the terminal's foreground, background,
     and ANSI palette, and rebuilds them when the terminal switches light/dark. */}}
{{- $_ := setValueAtPath "theme" "system" $current }}
{{- $_ := setValueAtPath "steeringMode" "one-at-a-time" $current }}
{{- $_ := setValueAtPath "transport" "auto" $current }}
{{- $_ := setValueAtPath "markdown.mermaid" "streaming" $current }}
{{- $_ := setValueAtPath "defaultProjectTrust" "ask" $current }}
{{- $_ := setValueAtPath "doubleEscapeAction" "none" $current }}
{{- $_ := setValueAtPath "fullscreenScrollbar" "auto" $current }}
{{- $_ := setValueAtPath "outputPad" 1 $current }}
{{- $_ := setValueAtPath "editorPaddingX" 1 $current }}
{{- /* Pin the thinking default: without it pi falls back to DEFAULT_THINKING_LEVEL
     "medium", which clamps to glm-5.3-flash's supported levels as "high" on a
     clean boot but "low" after modeldefault's setModel re-sync re-derives the level
     from a model-less session's "off" — the thinking level kept flapping. */}}
{{- $_ := setValueAtPath "defaultThinkingLevel" "high" $current }}
{{- /* Compaction continuity. The trigger is contextWindow - reserveTokens and the
     summary cap is 0.8 * reserveTokens, and the summarizer inherits the session
     thinking level. On the 1M-context models a 40960 reserve fires at ~959k, so one
     compaction squeezes ~940k tokens into a single summary; at 200000 it fires at
     ~800k and the cap rises to 160000, which keeps spans smaller and leaves no room
     for a length stop. keepRecentTokens 40000 keeps more of the tail verbatim.
     Caveat: no model override, so this applies everywhere. A model whose context
     window is at or below 200k will now cross the threshold immediately, and pi
     compacts on every check for it. */}}
{{- $_ := unset $current "compaction" }}
{{- $_ := setValueAtPath "compaction.reserveTokens" 200000 $current }}
{{- $_ := setValueAtPath "compaction.keepRecentTokens" 40000 $current }}
{{- /* defaultTools is deliberately unmanaged on Linux and macOS: pi's own defaults
     (read, bash, edit, write) are the tool set we want. A modify template only merges,
     so the key is evicted first to drop anything pi or a manual edit persisted into
     the deployed file. Native Windows is different: pi's bash fallback resolves to the
     WSL shim (%SystemRoot%\System32\bash.exe) whenever WSL is installed, so drop the
     bash tool and add the native powershell tool. Only -name/+name entries, so the
     delta mutates pi's inherited selection instead of replacing it. */}}
{{- $_ := unset $current "defaultTools" }}
{{- if eq .chezmoi.os "windows" }}
{{- $_ := setValueAtPath "defaultTools" (list "-bash" "+powershell") $current }}
{{- end }}
{{ toPrettyJson $current }}

