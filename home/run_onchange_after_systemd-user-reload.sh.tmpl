{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Service checksum makes unit edits rerun this onchange hook.
# dsh-web.service: {{ include "dot_config/systemd/user/dsh-web.service" | sha256sum }}
# Reload the user manager after a systemd unit change and keep dsh-web stopped
# and disabled. Environments without a user bus (containers, Cloud Shell, WSL)
# have nothing to reload, so exit quietly instead of leaking
# "Failed to connect to bus" noise into the apply output.
systemctl --user daemon-reload 2>/dev/null || exit 0
systemctl --user disable --now dsh-web.service
{{ end -}}