{{ if eq .chezmoi.os "windows" -}}
# ASCII only, and no fancy punctuation in strings: chezmoi writes this file as
# UTF-8 without a BOM, and Windows PowerShell 5.1 decodes a BOM-less file with
# the ANSI code page. A UTF-8 em dash then arrives as three bytes, one of which
# decodes to a quote character, and the parser reports "The string is missing
# the terminator" for the whole hook. Keep the text plain.
# Ensure directories exist
$dirs = @(
    "$HOME\.vim\backup"
)
foreach ($d in $dirs) {
    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }
}

$proxyEnabled = (Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -ErrorAction SilentlyContinue).ProxyEnable
if ($proxyEnabled -eq 1) {
    Write-Host "System proxy detected - run Set-ProxyCredential to store proxy credentials in Windows Credential Manager" -ForegroundColor Yellow
}
{{ end -}}
