chezmoi:modify-template
{{- /* Cap every model whose catalog advertises a 1M-token (or larger) context
     window at 500k. Compaction keys off the advertised window, so an
     uncapped session grows past the point where these models stay coherent
     and cheap.

     modelOverrides keys are exact provider model IDs, not patterns, and pi
     has no global cap, so the IDs are enumerated: the union of
     `pi --list-models` (1M and up) and the hyper, cline-pass, and commandcode
     catalogs in exact_extensions/exact_providers. Refresh the list when a
     catalog gains a 1M model. Unknown IDs are ignored by pi, so a retired
     entry is harmless. Paths are lists because the IDs contain dots and
     slashes. Everything else in models.json, including custom providers and
     other override fields, is preserved. */}}
{{- $current := fromJson (.chezmoi.stdin | default "{}") }}
{{- $cap := 500000 }}
{{- $models := dict
    "cline-pass" (list
        "cline-pass/deepseek-v4-flash"
        "cline-pass/deepseek-v4-pro"
        "cline-pass/deepseek-v4.1-flash"
        "cline-pass/glm-5.3-flash"
        "cline-pass/kimi-k3"
        "cline-pass/mimo-v2.5"
        "cline-pass/minimax-m3"
        "cline-pass/qwen3.8-max")
    "commandcode" (list
        "claude-fable-5"
        "claude-fable-5-1"
        "claude-opus-4-7"
        "claude-opus-4-8"
        "claude-opus-5"
        "claude-sonnet-4-6"
        "claude-sonnet-5"
        "deepseek/deepseek-v4-flash"
        "deepseek/deepseek-v4-flash-fast"
        "deepseek/deepseek-v4-flash-vision-exp"
        "deepseek/deepseek-v4-pro"
        "deepseek/deepseek-v4.1-flash"
        "google/gemini-3.1-flash-lite"
        "google/gemini-3.5-flash"
        "google/gemini-3.5-flash-lite"
        "google/gemini-3.6-flash"
        "google/gemini-3.7-flash"
        "google/gemini-3.8-flash"
        "gpt-5.6-luna"
        "gpt-5.6-sol"
        "gpt-5.6-terra"
        "meituan/LongCat-2.0:free"
        "meta/muse-spark-1.1"
        "meta/muse-spark-1.2"
        "meta/muse-spark-1.2-contributor"
        "meta/muse-spark-1.3"
        "meta/muse-spark-1.3-contributor"
        "MiniMaxAI/MiniMax-M3"
        "moonshotai/Kimi-K3"
        "nvidia/nemotron-3-ultra-550b-a55b"
        "Qwen/Qwen3.7-Flash"
        "Qwen/Qwen3.7-Max"
        "Qwen/Qwen3.7-Plus"
        "Qwen/Qwen3.8-Flash"
        "Qwen/Qwen3.8-Max"
        "Qwen/Qwen3.8-Max-0902"
        "sakana/fugu-ultra"
        "stepfun/Step-3.5-Flash"
        "tencent/hy4-preview"
        "thinkingmachines/inkling-small"
        "xiaomi/mimo-v2.5"
        "xiaomi/mimo-v2.5-pro"
        "z-ai/glm-5.3-flash"
        "zai-org/GLM-5.2"
        "zai-org/GLM-5.2-Fast"
        "zai-org/GLM-5.3")
    "deepseek" (list
        "deepseek-flash"
        "deepseek-v4-pro")
    "hyper" (list
        "deepseek-v4-flash"
        "deepseek-v4-pro"
        "deepseek-v4.1-flash"
        "glm-5.3"
        "glm-5.3-flash"
        "kimi-k3"
        "qwen3.7-max"
        "qwen3.7-plus"
        "qwen3.8-flash"
        "qwen3.8-max")
    "opencode-go" (list
        "beam-free"
        "claude-haiku-5-5"
        "deepseek-v4-pro"
        "deepseek-v4.1-flash"
        "gemini-4-argon"
        "glm-5.2"
        "glm-5.3"
        "glm-5.3-flash"
        "gpt-5.6-luna"
        "gpt-6-luna"
        "hy4-preview"
        "kimi-k3"
        "kimi-k3.1-pro"
        "longcat-2.0"
        "mimo-v2.5"
        "mimo-v2.5-pro"
        "mimo-v2.6-flash"
        "mimo-v2.6-pro"
        "minimax-m3"
        "minimax-m3.1-flash"
        "muse-spark-1.2-contributor"
        "muse-spark-1.3-contributor"
        "qwen3.7-plus"
        "qwen3.8-flash"
        "qwen3.8-max"
        "step-5-preview") }}
{{- range $provider, $ids := $models }}
{{- range $id := $ids }}
{{- $_ := setValueAtPath (list "providers" $provider "modelOverrides" $id "contextWindow") $cap $current }}
{{- end }}
{{- end }}
{{- toPrettyJson $current -}}
