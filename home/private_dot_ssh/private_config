Host *
  ConnectTimeout 30
  StrictHostKeyChecking accept-new
  LogLevel ERROR
  ServerAliveInterval 30
  ServerAliveCountMax 3
  AddKeysToAgent yes
# The three tailnet machines keep no host key: their keys change on rebuild,
# and the prompt stops an unattended session. Everywhere else the wildcard
# above applies, so ~/.ssh/known_hosts is written and checked again.
Host nexus citadel outpost
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
Host nexus
  User root
  Hostname 100.64.0.3
Host citadel
  User dat
  Hostname 100.64.0.1
Host outpost
  User dat
  Hostname 100.64.0.2
