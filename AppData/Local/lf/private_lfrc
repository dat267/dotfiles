# Basic Settings
set nohidden
set preview
set nodrawbox
set noroundbox
set noicons
set ignorecase
set smartcase
set info             # Minimal: no size/time columns in list by default
set scrolloff 5
set timefmt "2006-01-02 15:04"
set ratios 1:2:3
set promptfmt "\033[34;1m%d\033[0m\033[1m %f\033[0m"
set statfmt "\033[36m%p\033[0m | %S | %t"

# Windows shell setup
set shell powershell
set shellflag "-NoProfile -Command"

# Functions/Commands

cmd edit-config %{{
    $editor = if ($env:EDITOR) { $env:EDITOR } else { "notepad" }
    if (Get-Command chezmoi -ErrorAction SilentlyContinue) {
        $src = (chezmoi source-path "$env:LOCALAPPDATA\lf\lfrc" 2>$null)
        if ($src -and (Test-Path $src)) {
            Start-Process $editor -ArgumentList $src -Wait
            chezmoi apply "$env:LOCALAPPDATA\lf\lfrc"
            lf -remote "send $id source `"$env:LOCALAPPDATA\lf\lfrc`""
            return
        }
    }
    Start-Process $editor -ArgumentList "$env:LOCALAPPDATA\lf\lfrc" -Wait
    lf -remote "send $id source `"$env:LOCALAPPDATA\lf\lfrc`""
}}

cmd open %{{
    foreach ($file in $args) {
        $ext = [System.IO.Path]::GetExtension($file).ToLower()
        if ($ext -in (".txt", ".md", ".json", ".xml", ".yml", ".yaml", ".sh", ".ps1", ".bat", ".ini", ".conf", ".cfg", ".lfrc", ".gitconfig")) {
            $editor = if ($env:EDITOR) { $env:EDITOR } else { "notepad" }
            Start-Process $editor -ArgumentList $file -Wait
        } else {
            Start-Process $file
        }
    }
}}

cmd mkdir %{{
    $dir = $args -join ' '
    if ($dir) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
}}

cmd create-file %{{
    $file = $args -join ' '
    if ($file) { New-Item -ItemType File -Path $file -Force | Out-Null }
}}

cmd follow_link %{{
    $target = (Get-Item $env:f).Target
    if ($target) {
        lf -remote "send $id select `"$target`""
    }
}}

cmd q :{{
    quit
}}

cmd q! :{{
    quit
}}

cmd x :{{
    quit
}}

# Clipboard Actions using Set-Clipboard
cmd copy-path %{{
    Set-Clipboard -Value $env:f
    lf -remote "send $id echo 'Copied absolute path to clipboard'"
}}

cmd copy-filename %{{
    $name = Split-Path $env:f -Leaf
    Set-Clipboard -Value $name
    lf -remote "send $id echo 'Copied filename to clipboard'"
}}

cmd copy-dirpath %{{
    $dir = Split-Path $env:f -Parent
    Set-Clipboard -Value $dir
    lf -remote "send $id echo 'Copied parent directory path to clipboard'"
}}

# Bulk Rename inside $EDITOR
cmd bulk-rename %{{
    $oldList = [System.IO.Path]::GetTempFileName()
    $newList = [System.IO.Path]::GetTempFileName()
    if ($env:fx) {
        $files = $args
    } else {
        $files = Get-ChildItem -Path $pwd.Path | Select-Object -ExpandProperty FullName
    }
    $files | Out-File -FilePath $oldList -Encoding utf8
    $files | ForEach-Object { Split-Path $_ -Leaf } | Out-File -FilePath $newList -Encoding utf8
    $editor = if ($env:EDITOR) { $env:EDITOR } else { "notepad" }
    Start-Process $editor -ArgumentList $newList -Wait
    $oldNames = Get-Content $oldList
    $newNames = Get-Content $newList
    if ($oldNames.Count -ne $newNames.Count) {
        lf -remote "send $id echo 'Line count mismatch! Bulk rename aborted.'"
        Remove-Item $oldList, $newList -Force
        return
    }
    for ($i = 0; $i -lt $oldNames.Count; $i++) {
        $old = $oldNames[$i]
        $new = $newNames[$i]
        if ($new) {
            $dir = Split-Path $old -Parent
            $newPath = Join-Path $dir $new
            if ($old -ne $newPath) {
                Move-Item -Path $old -Destination $newPath -Force
            }
        }
    }
    Remove-Item $oldList, $newList -Force
    lf -remote "send $id reload"
}}

# Safe permanent deletion with confirmation dialog
cmd delete %{{
    Clear-Host
    Write-Host "WARNING: You are about to PERMANENTLY delete the following files/folders:" -ForegroundColor Red
    Write-Host
    foreach ($file in $args) {
        Write-Host "  $file"
    }
    Write-Host
    $ans = Read-Host "Are you sure you want to permanently delete these $($args.Count) files? [y/N]"
    if ($ans -eq "y" -or $ans -eq "Y") {
        foreach ($file in $args) {
            Remove-Item -Path $file -Recurse -Force
        }
        lf -remote "send $id reload"
        lf -remote "send $id echo 'Permanently deleted $($args.Count) files'"
    } else {
        lf -remote "send $id echo 'Deletion aborted'"
    }
}}

# Recycle Bin (Trash) Actions using Microsoft.VisualBasic shell namespace
cmd trash %{{
    Add-Type -AssemblyName Microsoft.VisualBasic
    foreach ($file in $args) {
        if (Test-Path $file -PathType Container) {
            [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory($file, 'OnlyErrorDialogs', 'SendToRecycleBin')
        } else {
            [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile($file, 'OnlyErrorDialogs', 'SendToRecycleBin')
        }
    }
    lf -remote "send $id reload"
    lf -remote "send $id echo 'Moved $($args.Count) files to Recycle Bin'"
}}

cmd trash-restore %{{
    lf -remote "send $id echo 'trash-restore is not supported on Windows'"
}}

cmd trash-empty %{{
    $ans = Read-Host "Empty Recycle Bin? [y/N]"
    if ($ans -eq "y" -or $ans -eq "Y") {
        Clear-RecycleBin -Force -ErrorAction SilentlyContinue
        lf -remote "send $id echo 'Recycle Bin emptied'"
    } else {
        lf -remote "send $id echo 'Aborted'"
    }
}}

# Fuzzy Searching & Jump Integration using fzf
cmd fzf-search %{{
    if (Get-Command fd -ErrorAction SilentlyContinue) {
        $res = fd --hidden --follow --exclude .git | fzf --height=40% --reverse --header='Search files'
    } else {
        $res = Get-ChildItem -Recurse -Name | fzf --height=40% --reverse --header='Search files'
    }
    if ($res) {
        if (Test-Path $res -PathType Container) {
            lf -remote "send $id cd `"$res`""
        } else {
            lf -remote "send $id select `"$res`""
        }
    }
}}

cmd fzf-grep %{{
    if (Get-Command rg -ErrorAction SilentlyContinue) {
        $res = (rg --column --line-number --no-heading --color=always --smart-case . | fzf --ansi --height=40% --reverse --header='Search file contents (ripgrep)') -split ':'
        if ($res[0]) {
            lf -remote "send $id select `"$($pwd.Path)\$($res[0])`""
        }
    } else {
        lf -remote "send $id echo 'ripgrep (rg) is required for fzf-grep'"
    }
}}

cmd zoxide-jump %{{
    if (Get-Command zoxide -ErrorAction SilentlyContinue) {
        $res = zoxide query -l | fzf --height=40% --reverse --header='Jump to directory'
        if ($res) {
            lf -remote "send $id cd `"$res`""
        }
    } else {
        lf -remote "send $id echo 'zoxide is not installed'"
    }
}}

# Archive Operations
cmd extract_archive %{{
    $file = $env:f
    $name = [System.IO.Path]::GetFileName($file)
    $dst = [System.IO.Path]::GetFileNameWithoutExtension($file)
    if ($file -match '\.(zip)$') {
        New-Item -ItemType Directory -Path $dst -Force | Out-Null
        Expand-Archive -Path $file -DestinationPath $dst -Force
    } elseif ($file -match '\.(tar|tar\.gz|tgz|tar\.xz|txz|rar|7z)$' -and (Get-Command 7z -ErrorAction SilentlyContinue)) {
        New-Item -ItemType Directory -Path $dst -Force | Out-Null
        Start-Process 7z -ArgumentList "x -y `"$file`" -o`"$dst`"" -Wait
    } else {
        lf -remote "send $id echo 'Unsupported archive or 7z missing: $name'"
    }
}}

cmd compress_zip %{{
    $out = if ($env:fx) { Split-Path $pwd.Path -Leaf } else { [System.IO.Path]::GetFileNameWithoutExtension($env:f) }
    $out = "$out.zip"
    Compress-Archive -Path $args -DestinationPath $out -Force
}}

