{{ if eq .chezmoi.os "windows" -}}
$docsDir = [System.Environment]::GetFolderPath('MyDocuments')

# Clean up legacy lf junction if it exists to allow chezmoi to write a real directory
$legacyLf = "$env:LOCALAPPDATA\lf"
$lfItem = Get-Item -Force $legacyLf -ErrorAction SilentlyContinue
if ($lfItem -and $lfItem.Attributes -match "ReparsePoint") {
    Remove-Item -Recurse -Force $legacyLf -ErrorAction SilentlyContinue
}

$folderMap = @{
    "$HOME\-chezmoi"                                 = "{{ .chezmoi.sourceDir }}"
    "$env:LOCALAPPDATA\nvim"                         = "{{ .chezmoi.homeDir }}/.config/nvim"
    "$env:LOCALAPPDATA\aria2"                        = "{{ .chezmoi.homeDir }}/.config/aria2"
    "$env:APPDATA\Code\User"                         = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\Code - OSS\User"                   = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\yazi\config"                       = "{{ .chezmoi.homeDir }}/.config/yazi"
    "$HOME\scoop\persist\vscode\data\user-data\User" = "{{ .chezmoi.homeDir }}/.config/Code/User"
}

function Create-Junction($link, $target) {
    $target = $target.Replace('/', '\')
    $item = Get-Item -Force $link -ErrorAction SilentlyContinue
    if ($item) {
        # Already a junction pointing to the right place — skip
        if ($item.Attributes -match "ReparsePoint" -and $item.Target -eq $target) { return }
        # Otherwise backup real directory or remove link so we can re-create
        if ($item.Attributes -notmatch "ReparsePoint") {
            $bakPath = "${link}.bak"
            if (Test-Path $bakPath) { Remove-Item -Recurse -Force $bakPath -ErrorAction SilentlyContinue }
            Rename-Item -Path $link -NewName (Split-Path $bakPath -Leaf) -Force
        } else {
            Remove-Item -Recurse -Force $link -ErrorAction SilentlyContinue
        }
    }

    $parentDir = Split-Path -Parent $link
    if (-not (Test-Path $parentDir)) {
        New-Item -ItemType Directory -Force -Path $parentDir | Out-Null
    }

    New-Item -ItemType Junction -Path $link -Target $target -Force | Out-Null
}

foreach ($pair in $folderMap.GetEnumerator()) {
    Create-Junction $pair.Name $pair.Value
}

# PS7: ensure stub $PROFILE sources the chezmoi-managed profile.
# Avoids fighting OneDrive over the PowerShell directories (which have synced modules).
$profiles = @(
    "$docsDir\PowerShell\Microsoft.PowerShell_profile.ps1"
)
$sourceLine = 'if (Test-Path "$HOME\.config\powershell\Microsoft.PowerShell_profile.ps1") { . "$HOME\.config\powershell\Microsoft.PowerShell_profile.ps1" }'

foreach ($prof in $profiles) {
    if (Test-Path $prof) {
        $content = Get-Content $prof -Raw
        
        # Check if the guarded $HOME-relative sourcing line already exists
        $newPattern = '(?i)Test-Path\s*[''"]?(?:\$HOME|\$env:USERPROFILE)\\.config\\powershell\\Microsoft\.PowerShell_profile\.ps1[''"]?'
        $hasSource = $false
        if ($content -and $content -match $newPattern) {
            $hasSource = $true
        }

        if (-not $hasSource) {
            $newContent = $sourceLine + "`r`n" + ($content ? $content.Trim() : "")
            Set-Content -Path $prof -Value $newContent -Encoding UTF8
        }
    } else {
        $profDir = Split-Path $prof -Parent
        New-Item -ItemType Directory -Force -Path $profDir | Out-Null
        Set-Content -Path $prof -Value ($sourceLine + "`r`n") -Encoding UTF8
    }
}

# WezTerm: write a stub .wezterm.lua in $HOME that delegates to the XDG config
$weztermStubPath = "{{ .chezmoi.homeDir }}/.wezterm.lua"
$weztermStubPath = $weztermStubPath.Replace('/', '\')
$weztermStubVal  = "return dofile(os.getenv('USERPROFILE') .. '/.config/wezterm/wezterm.lua')"
if (-not (Test-Path $weztermStubPath) -or (Get-Content $weztermStubPath -Raw).Trim() -ne $weztermStubVal.Trim()) {
    Set-Content -Path $weztermStubPath -Value $weztermStubVal -Encoding UTF8
}

# Windows Terminal: create a shortcut in Start Menu with Ctrl+Alt+T hotkey
if (Get-Command wt.exe -ErrorAction SilentlyContinue) {
    $WshShell = New-Object -ComObject WScript.Shell
    $ShortcutPath = "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Windows Terminal.lnk"
    $Shortcut = $WshShell.CreateShortcut($ShortcutPath)
    $Shortcut.TargetPath = "wt.exe"
    $Shortcut.Hotkey = "CTRL+ALT+T"
    $Shortcut.Save()
}
{{ end -}}