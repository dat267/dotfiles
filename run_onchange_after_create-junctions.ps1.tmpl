{{ if eq .chezmoi.os "windows" -}}
$docsDir = [System.Environment]::GetFolderPath('MyDocuments')
$folderMap = @{
    "$HOME\-chezmoi"                                 = "{{ .chezmoi.sourceDir }}"
    "$env:LOCALAPPDATA\nvim"                         = "{{ .chezmoi.homeDir }}/.config/nvim"
    "$env:LOCALAPPDATA\aria2"                        = "{{ .chezmoi.homeDir }}/.config/aria2"
    "$env:LOCALAPPDATA\lf"                           = "{{ .chezmoi.homeDir }}/.config/lf"
    "$env:APPDATA\Code\User"                         = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\Code - OSS\User"                   = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\yazi\config"                       = "{{ .chezmoi.homeDir }}/.config/yazi"
    "$HOME\scoop\persist\vscode\data\user-data\User" = "{{ .chezmoi.homeDir }}/.config/Code/User"
}

foreach ($pair in $folderMap.GetEnumerator()) {
    $link   = $pair.Name
    $target = $pair.Value.Replace('/', '\')

    $item = Get-Item -Force $link -ErrorAction SilentlyContinue
    if ($item) {
        # Already a junction pointing to the right place — skip
        if ($item.Attributes -match "ReparsePoint" -and $item.Target -eq $target) { continue }
        # Otherwise backup real directory or remove link so we can re-create
        if ($item.Attributes -notmatch "ReparsePoint") {
            $bakPath = "${link}.bak"
            if (Test-Path $bakPath) { Remove-Item -Recurse -Force $bakPath -ErrorAction SilentlyContinue }
            Rename-Item -Path $link -NewName (Split-Path $bakPath -Leaf) -Force
        } else {
            Remove-Item -Recurse -Force $link -ErrorAction SilentlyContinue
        }
    }

    $parentDir = Split-Path -Parent $link
    if (-not (Test-Path $parentDir)) {
        New-Item -ItemType Directory -Force -Path $parentDir | Out-Null
    }

    New-Item -ItemType Junction -Path $link -Target $target -Force | Out-Null
}

# PS7: ensure the stub $PROFILE sources the chezmoi-managed profile.
# Avoids fighting OneDrive over the PowerShell dir (which has synced modules).
$ps7Profile = "$docsDir\PowerShell\Microsoft.PowerShell_profile.ps1"
$dotfilesProfile = "{{ .chezmoi.homeDir }}/.config/powershell/Microsoft.PowerShell_profile.ps1".Replace('/', '\')
$sourceLine = ". `"$dotfilesProfile`""

if (Test-Path $ps7Profile) {
    $content = Get-Content $ps7Profile -Raw
    $hasSource = $false
    if ($content) {
        $escapedPath = [regex]::Escape($dotfilesProfile)
        $pattern = "(?i)\.\s*`"?$escapedPath`"?"
        if ($content -match $pattern) {
            $hasSource = $true
        }
    }
    if (-not $hasSource) {
        $newContent = $sourceLine + "`r`n" + $content
        Set-Content -Path $ps7Profile -Value $newContent -Encoding UTF8
    }
} else {
    New-Item -ItemType Directory -Force -Path (Split-Path $ps7Profile) | Out-Null
    Set-Content -Path $ps7Profile -Value ($sourceLine + "`r`n") -Encoding UTF8
}

# WezTerm: write a stub .wezterm.lua in $HOME that delegates to the XDG config
$weztermStubPath = "{{ .chezmoi.homeDir }}/.wezterm.lua"
$weztermStubPath = $weztermStubPath.Replace('/', '\')
$weztermStubVal  = "return dofile(os.getenv('USERPROFILE') .. '/.config/wezterm/wezterm.lua')"
if (-not (Test-Path $weztermStubPath) -or (Get-Content $weztermStubPath -Raw).Trim() -ne $weztermStubVal.Trim()) {
    Set-Content -Path $weztermStubPath -Value $weztermStubVal -Encoding UTF8
}
{{ end -}}