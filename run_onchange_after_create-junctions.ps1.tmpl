{{ if eq .chezmoi.os "windows" -}}
$docsDir = [System.Environment]::GetFolderPath('MyDocuments')
$script:junctionFailures = 0

# Normalize a path for junction-target comparison: strip trailing separators
# and resolve to a full path so "C:\Users\x\.config\nvim" and
# "c:\users\x\.config\nvim\"" compare equal. Both '/' and '\' are treated as
# separators so comparison stays correct on any host.
function Test-SameTarget {
    param($a, $b)
    if (-not $a -or -not $b) { return $false }
    $a = $a.Trim().Replace('\', '/')
    $b = $b.Trim().Replace('\', '/')
    try { $a = [System.IO.Path]::GetFullPath($a) } catch {}
    try { $b = [System.IO.Path]::GetFullPath($b) } catch {}
    $a = $a.Replace('\', '/').TrimEnd('/')
    $b = $b.Replace('\', '/').TrimEnd('/')
    $a -ieq $b
}

# Remove a reparse point (junction/symlink) without ever touching its target.
# (Get-Item).Delete() removes only the link itself. Do NOT use
# Remove-Item -Recurse -Force here: under Windows PowerShell 5.1 it follows the
# junction and deletes the target directory's contents.
function Remove-ReparsePointSafely {
    param($link)
    $item = Get-Item -Force -LiteralPath $link -ErrorAction SilentlyContinue
    if ($item -and $item.Attributes -match "ReparsePoint") {
        $item.Delete()
    }
}

# Timestamped backup name that never collides with an existing backup. Existing
# backups are never deleted — an old .bak may be the only copy of user data.
function New-UniqueBackupPath {
    param($link)
    $stamp = Get-Date -Format "yyyyMMdd-HHmmss"
    $candidate = "$link.bak-$stamp"
    $n = 1
    while (Test-Path -LiteralPath $candidate) {
        $candidate = "$link.bak-$stamp-$n"
        $n++
    }
    $candidate
}

# Clean up legacy lf junction if it exists to allow chezmoi to write a real directory
$legacyLf = "$env:LOCALAPPDATA\lf"
$lfItem = Get-Item -Force -LiteralPath $legacyLf -ErrorAction SilentlyContinue
if ($lfItem -and $lfItem.Attributes -match "ReparsePoint") {
    Remove-ReparsePointSafely $legacyLf
}

$folderMap = @{
    "$HOME\-chezmoi"                                 = "{{ .chezmoi.sourceDir }}"
    "$env:LOCALAPPDATA\nvim"                         = "{{ .chezmoi.homeDir }}/.config/nvim"
    "$env:APPDATA\helix"                             = "{{ .chezmoi.homeDir }}/.config/helix"
    "$env:LOCALAPPDATA\aria2"                        = "{{ .chezmoi.homeDir }}/.config/aria2"
    "$env:APPDATA\Code\User"                         = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\Code - OSS\User"                   = "{{ .chezmoi.homeDir }}/.config/Code/User"
    "$env:APPDATA\yazi\config"                       = "{{ .chezmoi.homeDir }}/.config/yazi"
    "$HOME\scoop\persist\vscode\data\user-data\User" = "{{ .chezmoi.homeDir }}/.config/Code/User"
}

function Create-Junction($link, $target) {
    $target = $target.Replace('/', '\')
    $item = Get-Item -Force -LiteralPath $link -ErrorAction SilentlyContinue
    if ($item) {
        # Already a junction pointing to the right place — skip
        if ($item.Attributes -match "ReparsePoint" -and (Test-SameTarget $item.Target $target)) { return }
        # Otherwise backup real directory or remove link so we can re-create
        if ($item.Attributes -notmatch "ReparsePoint") {
            $bakPath = New-UniqueBackupPath $link
            try {
                Rename-Item -LiteralPath $link -NewName (Split-Path $bakPath -Leaf) -Force -ErrorAction Stop
            } catch {
                # The directory is in use (e.g. VS Code is open). Backing it up
                # fails, so creating the junction would too. Skip this one with a
                # clear message and flag the apply as incomplete.
                Write-Warning "Junction for '$link' skipped: the directory is in use (close the app using it, then re-run 'chezmoi apply'). Error: $($_.Exception.Message)"
                $script:junctionFailures++
                return
            }
        } else {
            Remove-ReparsePointSafely $link
        }
    }

    $parentDir = Split-Path -Parent $link
    if (-not (Test-Path -LiteralPath $parentDir)) {
        New-Item -ItemType Directory -Force -Path $parentDir | Out-Null
    }

    try {
        New-Item -ItemType Junction -Path $link -Target $target -Force -ErrorAction Stop | Out-Null
    } catch {
        Write-Warning "Junction for '$link' failed: $($_.Exception.Message)"
        $script:junctionFailures++
    }
}

foreach ($pair in $folderMap.GetEnumerator()) {
    Create-Junction $pair.Name $pair.Value
}

if ($script:junctionFailures -gt 0) {
    Write-Warning "$($script:junctionFailures) junction(s) could not be created. Close the affected apps and re-run 'chezmoi apply'."
    exit 1
}

# PS7: ensure stub $PROFILE sources the chezmoi-managed profile.
# Avoids fighting OneDrive over the PowerShell directories (which have synced modules).
$profiles = @(
    "$docsDir\PowerShell\Microsoft.PowerShell_profile.ps1"
)
$sourceLine = 'if (Test-Path "$HOME\.config\powershell\Microsoft.PowerShell_profile.ps1") { . "$HOME\.config\powershell\Microsoft.PowerShell_profile.ps1" }'

foreach ($prof in $profiles) {
    if (Test-Path $prof) {
        $content = Get-Content $prof -Raw
        
        # Check if the guarded $HOME-relative sourcing line already exists
        $newPattern = '(?i)Test-Path\s*[''"]?(?:\$HOME|\$env:USERPROFILE)\\.config\\powershell\\Microsoft\.PowerShell_profile\.ps1[''"]?'
        $hasSource = $false
        if ($content -and $content -match $newPattern) {
            $hasSource = $true
        }

        if (-not $hasSource) {
            $newContent = $sourceLine + "`r`n" + ($content ? $content.Trim() : "")
            Set-Content -Path $prof -Value $newContent -Encoding UTF8
        }
    } else {
        $profDir = Split-Path $prof -Parent
        New-Item -ItemType Directory -Force -Path $profDir | Out-Null
        Set-Content -Path $prof -Value ($sourceLine + "`r`n") -Encoding UTF8
    }
}

# WezTerm: write a stub .wezterm.lua in $HOME that delegates to the XDG config
$weztermStubPath = "{{ .chezmoi.homeDir }}/.wezterm.lua"
$weztermStubPath = $weztermStubPath.Replace('/', '\')
$weztermStubVal  = "return dofile(os.getenv('USERPROFILE') .. '/.config/wezterm/wezterm.lua')"
if (-not (Test-Path $weztermStubPath) -or (Get-Content $weztermStubPath -Raw).Trim() -ne $weztermStubVal.Trim()) {
    Set-Content -Path $weztermStubPath -Value $weztermStubVal -Encoding UTF8
}

# Windows Terminal: create a shortcut in Start Menu with Ctrl+Alt+T hotkey
if (Get-Command wt.exe -ErrorAction SilentlyContinue) {
    $WshShell = New-Object -ComObject WScript.Shell
    $ShortcutPath = "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Windows Terminal.lnk"
    $Shortcut = $WshShell.CreateShortcut($ShortcutPath)
    $Shortcut.TargetPath = "wt.exe"
    $Shortcut.Hotkey = "CTRL+ALT+T"
    $Shortcut.Save()
}
# Ensure hx function alias exists if helix is found on Windows
if ((Get-Command helix -ErrorAction SilentlyContinue) -and -not (Get-Command hx -ErrorAction SilentlyContinue)) {
    Set-Alias -Name hx -Value helix -Scope CurrentUser -ErrorAction SilentlyContinue
}
{{ end -}}